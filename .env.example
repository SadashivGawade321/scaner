# =============================================================================
# AAROGYA — Environment Variables Template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git — it is already in .gitignore
# =============================================================================

# ── Groq API (primary LLM — get your key at https://console.groq.com) ────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# ── Google Gemini API (optional fallback) ─────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB (optional — for user feedback storage) ────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=aarogya_db

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# ── Scoring ───────────────────────────────────────────────────────────────────
SCORE_VERSION=v1.0

# ── API ───────────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
